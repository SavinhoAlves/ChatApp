# --- Servidor ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# --- Banco de dados (PostgreSQL) ---
DATABASE_URL="postgresql://chat:chat@localhost:5432/chat?schema=public"

# --- Redis (opcional) ---
# Deixe vazio para usar memória. Para 2 pessoas não é necessário;
# use quando quiser mais de uma instância do servidor.
REDIS_URL=

# --- Segurança ---
# Gere um segredo longo:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-com-no-minimo-32-caracteres

# Cadastro: qualquer número que confirmar o código SMS cria conta.
# Depois de criar as contas necessárias, ponha REGISTRATION_OPEN=false.
REGISTRATION_OPEN=true

# Origens extras permitidas (CORS), separadas por vírgula. Vazio = mesma origem apenas.
CORS_ORIGINS=

# Pasta do front-end compilado (npm run generate em /web)
WEB_DIST=../web/.output/public

# --- SMS (codigo de ativacao por telefone) ---
# "console" imprime o codigo no log do servidor (so para desenvolvimento).
# Em producao use "twilio" (TWILIO_*), "smsgate" (SMSGATE_*) ou "whatsapp-admin" (CALLMEBOT_*).
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# "smsgate": envia pelo seu proprio Android, usando o chip dele. Instale o app SMS Gate
# (https://sms-gate.app), ative "Cloud server" e copie o usuario e a senha que ele mostra.
# Nao faz ligacao: numeros fixos/0800 nao conseguem receber o codigo.
SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_USERNAME=
SMSGATE_PASSWORD=

# "whatsapp-admin": o codigo vai para o SEU WhatsApp (CallMeBot, gratis, uso pessoal) e voce repassa.
# Ativacao: salve +34 644 95 73 56 nos contatos e mande "I allow callmebot to send me messages";
# o bot responde com a apikey. CALLMEBOT_PHONE e o seu numero com +55.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# --- Ligações (WebRTC) ---
# Opcional em desenvolvimento. Em produção, configure um servidor TURN (ex.: coturn na VPS)
# para as chamadas funcionarem mesmo atrás de redes/operadoras restritivas.
# Recomendado: coturn com use-auth-secret + static-auth-secret; aqui o MESMO segredo em TURN_SECRET.
# Várias URLs separadas por vírgula, ex.:
# TURN_URL=turn:SEU_IP:3478?transport=udp,turn:SEU_IP:3478?transport=tcp,turns:SEU_DOMINIO:5349?transport=tcp
TURN_URL=
TURN_SECRET=
# Alternativa (senha fixa, menos segura): coturn com lt-cred-mech + user=usuario:senha
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Notificações do app de iPhone (APNs) ---
# Chave criada em developer.apple.com › Certificates, IDs & Profiles › Keys (marque "Apple Push
# Notifications service"). Salve o .p8 no servidor (fora do git) e aponte o caminho aqui.
# Vazio = sem notificações nativas (o resto funciona normalmente).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_FILE=./apns.p8
APNS_BUNDLE_ID=com.savioalves.chat
# true só para builds de desenvolvimento do Xcode; TestFlight e App Store usam produção.
APNS_SANDBOX=false

# --- Notificações do app Android (Firebase Cloud Messaging) ---
# Firebase › Configurações do projeto › Contas de serviço › Gerar nova chave privada. Fora do git.
FCM_SERVICE_ACCOUNT_FILE=

# --- Mensagens ---
# Seu número "master" (com +55 e DDD): apaga qualquer mensagem para todos, sem prazo.
MASTER_PHONE=
# Prazo (minutos) para os demais apagarem a própria mensagem para todos. Depois, só "Apagar para mim".
DELETE_FOR_ALL_MINUTES=60
